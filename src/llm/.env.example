# 大模型 API 密钥配置示例
# 复制本文件为项目根目录下的 .env 并填入真实 Key：cp src/llm/.env.example .env
# ⚠️ .env 已被 .gitignore 忽略，严禁提交到 Git（防密钥泄露）

# 平台三选一（llm_config.py 默认优先 DEEPSEEK_*）
# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（OpenAI 兼容模式）：https://dashscope.console.aliyun.com/
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# 文心一言（千帆 V2 OpenAI 兼容接口）：https://console.bce.baidu.com/qianfan/
# ERNIE_API_KEY=xxxxxxxx
# ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
# ERNIE_MODEL=ernie-4.0-8k
